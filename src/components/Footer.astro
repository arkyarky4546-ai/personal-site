---
const year = new Date().getFullYear();

// One entry per link. LinkedIn goes here once the profile is ready.
const links = [{ label: 'GitHub', href: 'https://github.com/arkyarky4546-ai' }];
---

<footer class="wrapper">
  <p>Noah Kitayama, {year}</p>
  <ul class="cluster" role="list">
    {
      links.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
    margin-block-start: var(--space-2xl-3xl);
    padding-block: var(--space-m-l);
    border-block-start: var(--border-thin) solid var(--color-rule);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--step--1);
    line-height: var(--leading-normal);
    color: var(--color-ink-muted);
  }
</style>
