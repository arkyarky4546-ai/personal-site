---
// Links only to pages that exist, so the live site never has a dead link.
// Each phase adds its page to the nav when the page ships.
//
// The homepage has no header for now: its h1 is the name, and there is
// nothing else to put here yet. The About and Resume links will bring it back.
// The route pattern, not the URL: with build.format 'file' the homepage's
// URL is /index.html while it builds.
const isHome = Astro.routePattern === '/';
const isProjects = Astro.routePattern === '/projects';
---

{
  !isHome && (
    <>
      <a class="skip-link" href="#main">
        Skip to content
      </a>
      <header class="wrapper">
        <a class="name" href="/">
          Noah Kitayama
        </a>
        <nav aria-label="Site">
          <a href="/projects" aria-current={isProjects ? 'page' : undefined}>
            Projects
          </a>
        </nav>
      </header>
    </>
  )
}

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-s-m);
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    line-height: var(--leading-normal);
  }

  .name {
    color: var(--color-ink);
    text-decoration: none;
  }

  .name:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  [aria-current='page'] {
    color: var(--color-ink);
    text-decoration: none;
  }
</style>
