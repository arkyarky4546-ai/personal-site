---
// Links only to pages that exist, so the live site never has a dead link.
// Add a <nav> here when the second page ships.
//
// The homepage has no header for now: its h1 is the name, and there is
// nothing else to put here yet. The About and Resume links will bring it back.
// The route pattern, not the URL: with build.format 'file' the homepage's
// URL is /index.html while it builds.
const isHome = Astro.routePattern === '/';
---

{
  !isHome && (
    <>
      <a class="skip-link" href="#main">
        Skip to content
      </a>
      <header class="wrapper">
        <a class="name" href="/">
          Noah Kitayama
        </a>
      </header>
    </>
  )
}

<style>
  header {
    padding-block: var(--space-s-m);
  }

  .name {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    line-height: var(--leading-normal);
    color: var(--color-ink);
    text-decoration: none;
  }

  .name:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
