// Static assets only. There is no "main" script, so no Worker code runs
// per request and nothing is metered. Stays on the Workers free plan.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noah-kitayama",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Must match trailingSlash: 'never' in astro.config.mjs.
    "html_handling": "drop-trailing-slash"
  }
}
